# =============================================================
# Self-Hosted LLM Inference Server — Environment Configuration
# Copy this file to .env and fill in the required values.
# =============================================================

# --- REQUIRED ---

# Secret key for API authentication.
# Clients must send: Authorization: Bearer <API_KEY>
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Absolute path to the directory on the HOST machine where your GGUF model is stored.
# Windows example:  MODEL_PATH=C:\Users\yourname\models
# Linux/Mac example: MODEL_PATH=/home/yourname/models
# The directory is mounted read-only into the llama-cpp container at /models
MODEL_PATH=

# --- OPTIONAL ---

# Separate key for admin endpoints (cache clear). Defaults to API_KEY if not set.
ADMIN_API_KEY=

# Which GGUF model file to load (relative to /models inside the container)
MODEL_FILE=mistral-7b-instruct-v0.2.Q4_K_M.gguf

# Model display name (returned in /v1/models)
MODEL_NAME=mistral-7b

# Context window size in tokens (reduce to 2048 if running out of RAM)
CONTEXT_LENGTH=4096

# Default max_tokens when client does not specify
MAX_TOKENS_DEFAULT=512

# Number of model layers to offload to GPU (0 = CPU only)
N_GPU_LAYERS=0

# Number of CPU threads for llama.cpp (set to your CPU core count)
THREADS=8

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Rate limiting: max requests per minute per API key
RATE_LIMIT_RPM=60

# Semantic cache: similarity threshold for cache hits (0.0-1.0)
CACHE_SIMILARITY_THRESHOLD=0.95

# Cache TTL in seconds (default: 1 hour)
CACHE_TTL_SECONDS=3600

# Optional: webhook URL for p99 TTFT alerts (leave empty to disable)
ALERT_WEBHOOK_URL=
