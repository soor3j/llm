# =============================================================
# Self-Hosted LLM Inference Server — Environment Configuration
# Copy this file to .env and fill in the required values.
# =============================================================

# --- REQUIRED ---

# Secret key for API authentication.
# Clients must send: Authorization: Bearer <API_KEY>
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Absolute path to the directory on the HOST machine where your GGUF model is stored.
# Windows example:  MODEL_PATH=C:\Users\yourname\models
# Linux/Mac example: MODEL_PATH=/home/yourname/models
# The directory is mounted read-only into the llama-cpp container at /models
MODEL_PATH=

# --- OPTIONAL ---

# Separate key for admin endpoints (cache clear). Defaults to API_KEY if not set.
ADMIN_API_KEY=

# Which GGUF model file to load (relative to /models inside the container).
#
# Tested options — drop the file into your MODEL_PATH directory then set MODEL_FILE
# and MODEL_NAME accordingly. The chat template auto-detects from the filename.
#
#   Mistral 7B Instruct v0.2  (default — 4.1 GB)
#     MODEL_FILE=mistral-7b-instruct-v0.2.Q4_K_M.gguf
#     MODEL_NAME=mistral-7b
#
#   Llama 3.1 8B Instruct     (smarter, similar size — 4.9 GB)
#     MODEL_FILE=Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf
#     MODEL_NAME=llama-3.1-8b
#     Get it: https://huggingface.co/bartowski/Meta-Llama-3.1-8B-Instruct-GGUF
#
#   Qwen 2.5 7B Instruct      (best small model right now — 4.7 GB)
#     MODEL_FILE=Qwen2.5-7B-Instruct-Q4_K_M.gguf
#     MODEL_NAME=qwen-2.5-7b
#     Get it: https://huggingface.co/bartowski/Qwen2.5-7B-Instruct-GGUF
#
#   Phi-3.5 Mini Instruct     (2.5 GB — fastest, less capable)
#     MODEL_FILE=Phi-3.5-mini-instruct-Q4_K_M.gguf
#     MODEL_NAME=phi-3.5-mini
#     Get it: https://huggingface.co/bartowski/Phi-3.5-mini-instruct-GGUF
MODEL_FILE=mistral-7b-instruct-v0.2.Q4_K_M.gguf

# Model display name (returned in /v1/models)
MODEL_NAME=mistral-7b

# Chat-template family. "auto" picks one based on MODEL_NAME / MODEL_FILE.
# Override only if auto-detection picks the wrong one for your GGUF.
# Valid values: auto, mistral, llama3, qwen2, chatml, phi3, gemma
CHAT_TEMPLATE=auto

# Context window size in tokens (reduce to 2048 if running out of RAM)
CONTEXT_LENGTH=4096

# Default max_tokens when client does not specify
MAX_TOKENS_DEFAULT=512

# Number of model layers to offload to GPU (0 = CPU only)
N_GPU_LAYERS=0

# Number of CPU threads for llama.cpp (set to your CPU core count)
THREADS=8

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Rate limiting: max requests per minute per API key
RATE_LIMIT_RPM=60

# Semantic cache: similarity threshold for cache hits (0.0-1.0)
CACHE_SIMILARITY_THRESHOLD=0.95

# Cache TTL in seconds (default: 1 hour)
CACHE_TTL_SECONDS=3600

# Optional: webhook URL for p99 TTFT alerts (leave empty to disable)
ALERT_WEBHOOK_URL=
